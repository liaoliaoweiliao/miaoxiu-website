{
  "name": "miaoxiu-website",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --open",
    "build": "vite build",
    "build:standalone": "vite build --config vite.standalone.config.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && node scripts/package-desktop.mjs",
    "test:desktop": "node tests/desktop/acceptance.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "main": "electron/main.cjs",
  "description": "穿在身上的民族历史——苗绣 离线文化体验",
  "author": "苗绣文化网站项目组"
}
